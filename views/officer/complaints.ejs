<%- include('../partials/header') %>
<h5 class="mb-3">Complaints</h5>
<div class="mb-3">
  <select class="form-select form-select-sm w-auto d-inline-block" id="statusFilter">
    <option value="">All statuses</option>
    <% ['Submitted','Verified','Invalid','WorkOrderCreated','InProgress','CompletedByTechnician','Closed','Reopened'].forEach(function(s) { %>
      <option value="<%= s %>" <%= initialStatus === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
</div>
<div class="card p-3"><div id="list">Loading…</div></div>
<script>
async function render() {
  const status = document.getElementById('statusFilter').value;
  const list = document.getElementById('list');
  try {
    const data = await Api.get('/api/complaints/list' + (status ? '?status=' + status : ''));
    if (!data.complaints.length) { list.innerHTML = '<p class="text-muted">No complaints found.</p>'; return; }
    list.innerHTML = `<table class="table table-sm align-middle">
      <thead><tr><th>Code</th><th>Raised by</th><th>Location</th><th>Category</th><th>Priority</th><th>Status</th><th>Raised</th><th></th></tr></thead>
      <tbody>${data.complaints.map(c => `<tr>
        <td>${escapeHtml(c.complaint_code)}</td>
        <td>${escapeHtml(c.user_name)}</td>
        <td>${escapeHtml(c.building_name)}/${escapeHtml(c.room_name)}</td>
        <td>${escapeHtml(c.category)}</td>
        <td>${priorityBadge(c.priority)}</td>
        <td>${badge(c.status)}</td>
        <td>${fmtDate(c.created_at)}</td>
        <td><a href="/officer/complaint_detail?id=${c.id}" class="btn btn-sm btn-outline-primary">Open</a></td>
      </tr>`).join('')}</tbody></table>`;
  } catch (e) { showAlert(list, e.message); }
}
document.getElementById('statusFilter').addEventListener('change', render);
render();
</script>
<%- include('../partials/footer') %>
