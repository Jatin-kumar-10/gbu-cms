<%- include('../partials/header') %>
<div id="alertBox"></div>
<div class="card p-4 mb-4">
  <h6>Create User</h6>
  <form id="createForm" class="row g-2 align-items-end">
    <div class="col-md-3"><label class="form-label small">Name</label><input class="form-control form-control-sm" id="name" required></div>
    <div class="col-md-3"><label class="form-label small">Email</label><input type="email" class="form-control form-control-sm" id="email" required></div>
    <div class="col-md-2"><label class="form-label small">Password</label><input type="password" class="form-control form-control-sm" id="password" minlength="6" required></div>
    <div class="col-md-2">
      <label class="form-label small">Role</label>
      <select class="form-select form-select-sm" id="role">
        <option value="user">User</option>
        <option value="officer">Officer</option>
        <option value="technician">Technician</option>
        <option value="store">Store Officer</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <div class="col-md-2" id="deptWrap">
      <label class="form-label small">Department</label>
      <select class="form-select form-select-sm" id="department"></select>
    </div>
    <div class="col-12"><button class="btn btn-primary btn-sm mt-2" type="submit">Create</button></div>
  </form>
</div>
<div class="card p-3">
  <h6>All Users</h6>
  <div id="list">Loading…</div>
</div>
<script>
async function loadDepartments() {
  const data = await Api.get('/api/lookups/departments');
  document.getElementById('department').innerHTML =
    '<option value="">—</option>' + data.departments.map(d => `<option value="${d.id}">${escapeHtml(d.name)}</option>`).join('');
}
async function loadUsers() {
  const list = document.getElementById('list');
  const data = await Api.get('/api/admin_users/list');
  list.innerHTML = `<table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Status</th><th></th></tr></thead>
    <tbody>${data.users.map(u => `<tr>
      <td>${escapeHtml(u.name)}</td><td>${escapeHtml(u.email)}</td>
      <td><span class="badge text-bg-secondary">${escapeHtml(u.role)}</span></td>
      <td>${escapeHtml(u.department_name || '—')}</td>
      <td>${u.is_active == 1 ? '<span class="badge text-bg-success">Active</span>' : '<span class="badge text-bg-danger">Inactive</span>'}</td>
      <td><button class="btn btn-sm btn-outline-secondary toggleBtn" data-id="${u.id}">${u.is_active == 1 ? 'Deactivate' : 'Activate'}</button></td>
    </tr>`).join('')}</tbody></table>`;
  document.querySelectorAll('.toggleBtn').forEach(btn => btn.addEventListener('click', async () => {
    try { await Api.post('/api/admin_users/toggle_active?id=' + btn.dataset.id); loadUsers(); }
    catch (e) { showAlert(document.getElementById('alertBox'), e.message); }
  }));
}
document.getElementById('role').addEventListener('change', (e) => {
  document.getElementById('deptWrap').style.display = ['officer','technician'].includes(e.target.value) ? '' : 'none';
});
document.getElementById('createForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  try {
    await Api.post('/api/admin_users/create', {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      password: document.getElementById('password').value,
      role: document.getElementById('role').value,
      department_id: document.getElementById('department').value || null,
    });
    document.getElementById('createForm').reset();
    loadUsers();
  } catch (err) { showAlert(document.getElementById('alertBox'), err.message); }
});
loadDepartments();
loadUsers();
</script>
<%- include('../partials/footer') %>
