<%- include('../partials/header') %>
<div id="alertBox"></div>
<div class="row g-3">
  <div class="col-md-6">
    <div class="card p-4 mb-3">
      <h6>Add Building</h6>
      <form id="bForm" class="d-flex gap-2">
        <input class="form-control form-control-sm" id="bName" placeholder="Building name" required>
        <button class="btn btn-primary btn-sm" type="submit">Add</button>
      </form>
    </div>
    <div class="card p-3">
      <h6>Buildings</h6>
      <ul class="list-group list-group-flush" id="buildingList"></ul>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card p-4 mb-3">
      <h6>Add Room / Facility</h6>
      <form id="rForm" class="row g-2">
        <div class="col-6"><select class="form-select form-select-sm" id="rBuilding" required></select></div>
        <div class="col-4"><input class="form-control form-control-sm" id="rName" placeholder="Room name" required></div>
        <div class="col-2"><button class="btn btn-primary btn-sm w-100" type="submit">Add</button></div>
      </form>
    </div>
    <div class="card p-3">
      <h6>Rooms</h6>
      <div id="roomList"></div>
    </div>
  </div>
</div>
<script>
async function loadBuildings() {
  const data = await Api.get('/api/admin_locations/buildings');
  document.getElementById('buildingList').innerHTML = data.buildings.map(b => `<li class="list-group-item">${escapeHtml(b.name)}</li>`).join('') || '<li class="list-group-item text-muted">None yet.</li>';
  document.getElementById('rBuilding').innerHTML = data.buildings.map(b => `<option value="${b.id}">${escapeHtml(b.name)}</option>`).join('');
}
async function loadRooms() {
  const data = await Api.get('/api/admin_locations/rooms');
  document.getElementById('roomList').innerHTML = `<table class="table table-sm"><thead><tr><th>Building</th><th>Room</th></tr></thead>
    <tbody>${data.rooms.map(r => `<tr><td>${escapeHtml(r.building_name)}</td><td>${escapeHtml(r.name)}</td></tr>`).join('')}</tbody></table>`;
}
document.getElementById('bForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  try {
    await Api.post('/api/admin_locations/add_building', { name: document.getElementById('bName').value });
    document.getElementById('bForm').reset(); loadBuildings();
  } catch (err) { showAlert(document.getElementById('alertBox'), err.message); }
});
document.getElementById('rForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  try {
    await Api.post('/api/admin_locations/add_room', { building_id: document.getElementById('rBuilding').value, name: document.getElementById('rName').value });
    document.getElementById('rName').value = ''; loadRooms();
  } catch (err) { showAlert(document.getElementById('alertBox'), err.message); }
});
loadBuildings(); loadRooms();
</script>
<%- include('../partials/footer') %>
